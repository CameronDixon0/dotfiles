#!/bin/bash
# super minimal sketchybar — 16px, vague, aerospace
# https://github.com/vague-theme/vague.nvim

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Vague palette
# BG=0xff141415      # background (match nvim)
BG=0x00000000      # background (match nvim)
FG=0xffcdcdcd      # foreground
DIM=0xff606079     # comments / empty workspaces
MUTED=0xff878787   # floatBorder / occupied workspaces
LINE=0xff252530    # line
RED=0xffd8647e
GREEN=0xff7fa563
YELLOW=0xfff3be7c
BLUE=0xff6e94b2
PURPLE=0xffbb9dbd
CYAN=0xffb4d4cf
ORANGE=0xffe0a363

# --- Bar: 16px flat strip, no chrome ---
sketchybar --bar \
  height=16 \
  position=top \
  sticky=on \
  hidden=off \
  y_offset=0 \
  margin=3 \
  padding_left=6 \
  padding_right=6 \
  corner_radius=0 \
  border_width=0 \
  blur_radius=0 \
  shadow=off \
  notch_width=0 \
  color=$BG

# --- Defaults: tiny type to fit 16px, no backgrounds ---
sketchybar --default \
  padding_left=4 \
  padding_right=4 \
  icon.font="SF Pro:Bold:10.0" \
  label.font="SF Pro:Medium:10.0" \
  icon.color=$FG \
  label.color=$FG \
  icon.padding_left=0 \
  icon.padding_right=0 \
  label.padding_left=2 \
  label.padding_right=2 \
  background.drawing=off \
  popup.background.color=$BG \
  popup.background.border_color=$LINE \
  popup.background.border_width=1 \
  popup.background.corner_radius=4

# --- Aerospace workspaces (event-driven, no yabai) ---
sketchybar --add event aerospace_workspace_change

SPACES="1 2 3 4 5 6 7 m s"
for sid in $SPACES; do
  sketchybar --add item space.$sid left \
    --set space.$sid \
      icon.drawing=off \
      label="$sid" \
      label.font="SF Pro:Bold:10.0" \
      label.padding_left=3 \
      label.padding_right=3 \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh" \
    --subscribe space.$sid aerospace_workspace_change
done

# separator + active app
sketchybar --add item sep left \
  --set sep \
    icon.drawing=off \
    label="·" \
    label.color=$DIM \
    label.font="SF Pro:Regular:10.0" \
    label.padding_left=2 \
    label.padding_right=0

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.color=$MUTED \
    label.font="SF Pro:Regular:10.0" \
    label.padding_left=0 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# --- Right: only clock + battery ---
sketchybar --add item battery right \
  --set battery \
    update_freq=60 \
    icon.font="SF Pro:Bold:10.0" \
    label.font="SF Pro:Medium:10.0" \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# --- Center: pomodoro (Raycast-controlled, 1s tick) ---
sketchybar --add event pomodoro_update
sketchybar --add item pomodoro center \
  --set pomodoro \
    icon.drawing=off \
    update_freq=1 \
    label.font="SF Pro:Medium:10.0" \
    label.padding_left=2 \
    label.padding_right=2 \
    script="$PLUGIN_DIR/pomodoro.sh" \
    click_script="$PLUGIN_DIR/pomodoro-control.sh toggle" \
  --subscribe pomodoro pomodoro_update

sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon.font="SF Pro:Medium:10.0" \
    icon.padding_left=2 \
    icon.padding_right=4 \
    label.font="SF Pro:Medium:10.0" \
    label.padding_left=4 \
    label.padding_right=2 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --update
